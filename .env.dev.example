# Copy to .env.dev (gitignored) and `source .env.dev` before `cargo run`,
# matching `docker-compose.dev.yml` (Postgres + Mailpit + Sheets stub).
export DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/benefrance_dev
export LISTEN_ADDR=0.0.0.0:3000
export SMTP_HOST=127.0.0.1
export SMTP_PORT=1025
export SMTP_FROM=benefrance@example.org
# First superadmin, seeded idempotently at startup (specs.md §11.4).
export BOOTSTRAP_SUPERADMIN_EMAIL=you@example.org
