# Copy to .env.dev (gitignored) and `source .env.dev` before `cargo run`,
# matching `docker-compose.dev.yml` (Postgres + Mailpit + Sheets stub).
# Needed on a fresh DB: `sqlx::query!` checks column types against a live,
# already-migrated DB at *compile* time, and migrations only run once the
# binary starts — chicken and egg on a brand new volume. SQLX_OFFLINE=true
# compiles against the committed `backend/.sqlx/` cache instead; the
# scheduler/sync/sessions tables still get created normally at runtime by
# `sqlx::migrate!` in `main.rs`.
export SQLX_OFFLINE=true
export DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/benefrance_dev
export LISTEN_ADDR=0.0.0.0:3000
export SMTP_HOST=127.0.0.1
export SMTP_PORT=1025
export SMTP_FROM=benefrance@example.org
# Dev/e2e only: the dev server runs over plain http, so a `Secure` session
# cookie would never come back from the browser.
export SESSION_COOKIE_SECURE=false
# First superadmin, seeded idempotently at startup (specs.md §11.4).
export BOOTSTRAP_SUPERADMIN_EMAIL=you@example.org
# Points sync at the local sheets-stub (docker-compose.dev.yml) instead of
# the real Google API, with a throwaway dev key (dev/README.md). Any
# sheet_id works: the stub ignores it and always returns the 2027 form
# fixture. Unset both to disable sync entirely, or point
# GOOGLE_SERVICE_ACCOUNT_KEY_PATH at a real key + unset SHEETS_API_BASE_URL
# to exercise sync against the real Google API instead.
export GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./dev/service-account-key.dev.json
export SHEETS_API_BASE_URL=http://127.0.0.1:8089
